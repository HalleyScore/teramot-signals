# Copy to .env (gitignored). Local runs only; in CI credentials come from the environment.

# Output destination: local path or fsspec URI (s3://bucket/prefix, gs://bucket/prefix).
SIGNALS_OUTPUT_ROOT=data

# Only if the destination is S3 (install with `uv sync --extra s3`). A profile or a role also works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
